% core/structure.mtex
% Core structural primitives: sections, groups, and environments.
% Built entirely from already-bound primitives (\frac, \sqrt, math delimiters, etc.)
% No native C++ changes required below this line.

\def\section#1{
    \par
    \bigskip
    \textbf{#1}
    \par
    \medskip
}

\def\subsection#1{
    \par
    \medskip
    \textbf{#1}
    \par
    \smallskip
}

\def\subsubsection#1{
    \par
    \smallskip
    \textbf{#1}
    \par
}

\def\paragraphtitle#1{
    \textbf{#1}
    \unskip
    \space
}

\def\group#1{
    {#1}
}

\def\begin#1{
    \csname #1\endcsname
}

\def\end#1{
    \csname end#1\endcsname
}

\def\document{
    \par
}

\def\enddocument{
    \par
}

\def\center{
    \par
}

\def\endcenter{
    \par
}

\def\quote{
    \par
    \indent
}

\def\endquote{
    \par
}